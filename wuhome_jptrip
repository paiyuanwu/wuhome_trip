/* ============ render day pills & panels ============ */
const pillsWrap = document.getElementById("day-pills");
const panelsWrap = document.getElementById("day-panels");
let map, markerLayer;

days.forEach((d, i)=>{
  const pill = document.createElement("div");
  pill.className = "day-pill" + (i===0 ? " active":"");
  pill.dataset.idx = i;
  pill.innerHTML = d.date + '<span class="wk">('+d.wk+')</span>';
  pill.addEventListener("click", ()=> selectDay(i));
  pillsWrap.appendChild(pill);

  const panel = document.createElement("div");
  panel.className = "day-panel" + (i===0 ? " active":"");
  panel.dataset.idx = i;

  let html = '<div class="day-head"><span class="num">'+d.date+'</span><span class="wk">星期'+d.wk+'</span></div>';
  html += '<p class="day-title">'+d.title+'</p>';

  if(d.hotel){
    html += '<div class="hotel-banner"><span class="ic">🏨</span><span class="txt">今晚住宿：'+d.hotel.name+'</span>';
    html += '<a href="'+mapsLink(d.hotel.mapQuery)+'" target="_blank" rel="noopener">地圖</a></div>';
  }

  html += '<div class="timeline">';
  d.items.forEach(it=>{
    html += '<div class="item">';
    html += '<div class="badge">'+it.icon+'</div>';
    html += '<div class="body">';
    if(it.time) html += '<div class="time">'+it.time+'</div>';
    html += '<div class="name">'+it.name+'</div>';
    if(it.note) html += '<p class="note'+(it.note.indexOf("⚠️")===0?" warn":"")+'">'+it.note+'</p>';
    html += '<div class="links">';
    html += '<a class="map-link" href="'+mapsLink(it.mapQuery)+'" target="_blank" rel="noopener">📍 地圖</a>';
    if(it.official) html += '<a class="off-link" href="'+it.official+'" target="_blank" rel="noopener">🌐 官網</a>';
    if(it.link) html += '<a class="off-link" href="'+it.link+'" target="_blank" rel="noopener">🔗 介紹頁</a>';
    html += '</div></div></div>';
  });
  html += '</div>';

  panel.innerHTML = html;
  panelsWrap.appendChild(panel);
});

function selectDay(i){
  document.querySelectorAll(".day-pill").forEach(p=> p.classList.toggle("active", +p.dataset.idx===i));
  document.querySelectorAll(".day-panel").forEach(p=> p.classList.toggle("active", +p.dataset.idx===i));
  const pill = document.querySelector('.day-pill[data-idx="'+i+'"]');
  if(pill) pill.scrollIntoView({behavior:"smooth", inline:"center", block:"nearest"});
  renderMapForDay(i);
}

/* ============ map ============ */
function initMap(){
  map = L.map("overview-map", {zoomControl:true, attributionControl:true});
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom:18,
    attribution:'&copy; OpenStreetMap contributors'
  }).addTo(map);
  markerLayer = L.layerGroup().addTo(map);
  renderMapForDay(0);
}

function renderMapForDay(i){
  if(!map) return;
  markerLayer.clearLayers();
  const pts = days[i].items.filter(it=>it.big);
  if(pts.length===0){
    map.setView([35.68,139.75], 10);
    return;
  }
  const bounds = [];
  pts.forEach(it=>{
    const m = L.circleMarker([it.big.lat, it.big.lng], {
      radius:8, color:"#C1440E", weight:2, fillColor:"#C1440E", fillOpacity:0.85
    }).addTo(markerLayer);
    m.bindPopup('<b>'+it.name+'</b><br><a href="'+mapsLink(it.mapQuery)+'" target="_blank" rel="noopener">在 Google 地圖開啟</a>');
    bounds.push([it.big.lat, it.big.lng]);
  });
  if(bounds.length===1){
    map.setView(bounds[0], 13);
  } else {
    map.fitBounds(bounds, {padding:[30,30]});
  }
}

initMap();

