    {ja:"おすすめは何ですか？", kana:"osusume wa nan desu ka?", zh:"有推薦的餐點嗎？"},
    {ja:"辛くないものはありますか？", kana:"karakunai mono wa arimasu ka?", zh:"有不辣的餐點嗎？"},
    {ja:"お会計お願いします", kana:"okaikei onegai shimasu", zh:"麻煩結帳"},
    {ja:"美味しかったです", kana:"oishikatta desu", zh:"剛剛很好吃／很美味"}
  ]
};

const phraseTabsWrap = document.getElementById("phrase-tabs");
const phraseListWrap = document.getElementById("phrase-list");
const categories = Object.keys(phraseData);

function renderPhrases(cat){
  phraseListWrap.innerHTML = "";
  phraseData[cat].forEach(p=>{
    const card = document.createElement("div");
    card.className = "phrase-card";
    card.innerHTML =
      '<div class="txt"><p class="ja">'+p.ja+'</p><p class="kana">'+p.kana+'</p><p class="zh">'+p.zh+'</p></div>'+
      '<button class="speak-btn" aria-label="播放發音">🔊</button>';
    const btn = card.querySelector(".speak-btn");
    btn.addEventListener("click", ()=> speakJapanese(p.ja, btn));
    phraseListWrap.appendChild(card);
  });
}

categories.forEach((cat,i)=>{
  const tab = document.createElement("div");
  tab.className = "phrase-tab" + (i===0 ? " active":"");
  tab.textContent = cat;
  tab.addEventListener("click", ()=>{
    phraseTabsWrap.querySelectorAll(".phrase-tab").forEach(t=>t.classList.remove("active"));
    tab.classList.add("active");
    renderPhrases(cat);
  });
  phraseTabsWrap.appendChild(tab);
});
renderPhrases(categories[0]);

function speakJapanese(text, btn){
  if(!("speechSynthesis" in window)){
    alert("此瀏覽器不支援語音朗讀功能");
    return;
  }
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = "ja-JP";
  utter.rate = 0.9;
  btn.classList.add("playing");
  utter.onend = ()=> btn.classList.remove("playing");
  utter.onerror = ()=> btn.classList.remove("playing");
  window.speechSynthesis.speak(utter);
}
</script>
