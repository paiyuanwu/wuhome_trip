/* ============ currency: shopping estimator ============ */
const shopJpy = document.getElementById("shop-jpy");
const discountPct = document.getElementById("discount-pct");
const refundPct = document.getElementById("taxrefund-pct");
const feeToggle = document.getElementById("fee-toggle");
const rateInput = document.getElementById("rate-input");
const rAfterDiscount = document.getElementById("r-after-discount");
const rAfterRefund = document.getElementById("r-after-refund");
const rFee = document.getElementById("r-fee");
const rFinal = document.getElementById("r-final");

const refundPresetsWrap = document.getElementById("refund-presets");
[0,5,7,8,10,11].forEach(v=>{
  const b = document.createElement("button");
  b.type="button"; b.textContent = v+"%";
  if(v===0) b.classList.add("active");
  b.addEventListener("click", ()=>{
    refundPct.value = v;
    refundPresetsWrap.querySelectorAll("button").forEach(x=>x.classList.remove("active"));
    b.classList.add("active");
    recalcShop();
  });
  refundPresetsWrap.appendChild(b);
});
refundPct.addEventListener("input", ()=>{
  refundPresetsWrap.querySelectorAll("button").forEach(x=> x.classList.toggle("active", x.textContent === (refundPct.value+"%")));
});

function fmtJPY(n){ return "¥" + Math.round(n).toLocaleString("ja-JP"); }
function fmtTWD(n){ return "NT$" + n.toLocaleString("zh-TW", {maximumFractionDigits:1, minimumFractionDigits:0}); }

function recalcShop(){
  const base = parseFloat(shopJpy.value) || 0;
  const disc = parseFloat(discountPct.value) || 0;
  const refund = parseFloat(refundPct.value) || 0;
  const rate = parseFloat(rateInput.value) || 0;
  const feeOn = feeToggle.checked;

  const afterDiscount = base * (1 - disc/100);
  const afterRefund = afterDiscount * (1 - refund/100);
  const twdBeforeFee = afterRefund * rate;
  const fee = feeOn ? twdBeforeFee * 0.015 : 0;
  const finalTwd = twdBeforeFee + fee;

  rAfterDiscount.textContent = fmtJPY(afterDiscount);
  rAfterRefund.textContent = fmtJPY(afterRefund);
  rFee.textContent = feeOn ? ("＋" + fmtTWD(fee)) : "未計入";
  rFinal.textContent = fmtTWD(finalTwd);
}
[shopJpy, discountPct, refundPct, rateInput].forEach(el=> el.addEventListener("input", recalcShop));
feeToggle.addEventListener("change", recalcShop);
recalcShop();

/* ============ currency: quick bidirectional ============ */
const jpyInput = document.getElementById("jpy-input");
const twdInput = document.getElementById("twd-input");
let lastEdited = "jpy";
function recalcQuick(){
  const rate = parseFloat(rateInput.value) || 0;
  if(lastEdited==="jpy"){
    const jpy = parseFloat(jpyInput.value);
    twdInput.value = isNaN(jpy) ? "" : (jpy*rate).toFixed(1);
  } else {
    const twd = parseFloat(twdInput.value);
    jpyInput.value = (isNaN(twd) || rate===0) ? "" : (twd/rate).toFixed(0);
  }
}
jpyInput.addEventListener("input", ()=>{ lastEdited="jpy"; recalcQuick(); });
twdInput.addEventListener("input", ()=>{ lastEdited="twd"; recalcQuick(); });
rateInput.addEventListener("input", recalcQuick);

